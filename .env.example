# Database
DATABASE_URL="postgresql://user:password@localhost:5432/stoz_admin?schema=public"

# App
NEXTAUTH_URL="http://localhost:3000"
APP_SECRET="generate-a-random-secret-here"

# Email (SMTP for magic links)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-password"
SMTP_FROM="noreply@stoz-admin.nl"

# Set to "true" in development to skip email and auto-login
DEV_MODE="true"
