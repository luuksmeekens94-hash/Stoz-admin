generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INTERNAL
  EXTERNAL
  TEAM
}

enum HourStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum SurveyCampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum SurveyTemplateCode {
  THERAPIST_BASELINE
}

enum SurveyDeliveryStatus {
  PREPARED
  SENT
  FAILED
}

enum PlanningVersionStatus {
  CONCEPT
  ARCHIVED
}

enum PlanningSourceStatus {
  RECONSTRUCTED_PENDING_APPROVED_XLSX
  FORMALLY_CONFIRMED
}

enum PlanningReviewState {
  DRAFT
  REVIEWED
}

enum PlanningAllocationSourceState {
  OPERATIONAL_FORECAST
  APPROVED_REMAINING
  OUTSIDE_APPROVED_QUANTITY
  DECISION_REQUIRED
}

enum InvoiceVatTreatment {
  PENDING
  EXCLUDED
  INCLUDED_CONFIRMED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hourEntries         HourEntry[]
  magicLinks          MagicLink[]
  sessions            Session[]
  invoices            Invoice[]
  budgetAllocations   BudgetAllocation[]
  surveyCampaigns     SurveyCampaign[]
  planningVersions    PlanningVersion[]
  interimProposalSets InterimHourProposalSet[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model MagicLink {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model WorkPackage {
  id                   String                  @id @default(cuid())
  code                 String                  @unique
  name                 String
  activities           Activity[]
  hourEntries          HourEntry[]
  invoices             Invoice[]
  planAllocations      MonthlyPlanAllocation[]
  interimHourProposals InterimHourProposal[]
  createdAt            DateTime                @default(now())
}

model Activity {
  id                   String                  @id @default(cuid())
  code                 String                  @unique
  name                 String
  workPackageId        String
  workPackage          WorkPackage             @relation(fields: [workPackageId], references: [id])
  hourEntries          HourEntry[]
  planAllocations      MonthlyPlanAllocation[]
  interimHourProposals InterimHourProposal[]
  createdAt            DateTime                @default(now())
}

model HourEntry {
  id                    String     @id @default(cuid())
  date                  DateTime
  hours                 Float
  description           String
  status                HourStatus @default(DRAFT)
  userId                String
  workPackageId         String
  activityId            String
  therapistId           String?
  historicalProposalId  String?
  sourceForecastEntryId String?    @unique
  approvedAt            DateTime?
  approvedBy            String?
  // IMMUTABLE - critical for RVO audit
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user                User                 @relation(fields: [userId], references: [id])
  workPackage         WorkPackage          @relation(fields: [workPackageId], references: [id])
  activity            Activity             @relation(fields: [activityId], references: [id])
  therapist           Therapist?           @relation(fields: [therapistId], references: [id])
  historicalProposal  InterimHourProposal? @relation(fields: [historicalProposalId], references: [id], onDelete: Restrict)
  sourceForecastEntry ForecastEntry?       @relation(fields: [sourceForecastEntryId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([therapistId])
  @@index([status])
  @@index([workPackageId])
  @@index([historicalProposalId])
}

model Invoice {
  id                    String              @id @default(cuid())
  date                  DateTime
  supplier              String
  invoiceNumber         String
  description           String
  amountExVat           Float
  vatAmount             Float
  amountIncVat          Float
  paymentDate           DateTime?
  filePath              String?
  fileName              String?
  fileData              String?             @db.Text
  fileMime              String?
  workPackageId         String
  uploadedById          String
  confirmedBudgetLineId String?
  vatTreatment          InvoiceVatTreatment @default(PENDING)
  classificationReason  String?
  classifiedAt          DateTime?
  classifiedById        String?
  // IMMUTABLE
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  workPackage WorkPackage @relation(fields: [workPackageId], references: [id])
  uploadedBy  User        @relation(fields: [uploadedById], references: [id])

  @@index([workPackageId])
  @@index([confirmedBudgetLineId])
}

model Training {
  id        String             @id @default(cuid())
  name      String
  date      DateTime
  hours     Float
  topic     String
  notes     String?
  attendees TrainingAttendee[]
  // IMMUTABLE
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model TrainingAttendee {
  id         String   @id @default(cuid())
  trainingId String
  name       String
  present    Boolean  @default(false)
  signature  String?
  createdAt  DateTime @default(now())

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, name])
}

model Therapist {
  id                String             @id @default(cuid())
  name              String
  hourlyRate        Float?
  active            Boolean            @default(true)
  hourEntries       HourEntry[]
  surveyInvitations SurveyInvitation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model SurveyCampaign {
  id           String               @id @default(cuid())
  name         String
  templateCode SurveyTemplateCode   @default(THERAPIST_BASELINE)
  status       SurveyCampaignStatus @default(DRAFT)
  closesAt     DateTime
  createdById  String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  createdBy   User               @relation(fields: [createdById], references: [id])
  invitations SurveyInvitation[]

  @@index([status])
  @@index([createdById])
}

model SurveyInvitation {
  id               String    @id @default(cuid())
  campaignId       String
  therapistId      String?
  recipientName    String
  recipientEmail   String
  tokenHash        String?   @unique
  expiresAt        DateTime
  sentAt           DateTime?
  revokedAt        DateTime?
  deliveryLockedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campaign   SurveyCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  therapist  Therapist?       @relation(fields: [therapistId], references: [id])
  response   SurveyResponse?
  deliveries SurveyDelivery[]

  @@unique([campaignId, recipientEmail])
  @@index([campaignId])
  @@index([therapistId])
  @@index([expiresAt])
}

model SurveyDelivery {
  id                String               @id @default(cuid())
  invitationId      String
  status            SurveyDeliveryStatus
  provider          String
  providerMessageId String?
  attemptedAt       DateTime             @default(now())
  sentAt            DateTime?
  failureCode       String?
  failureMessage    String?              @db.Text

  invitation SurveyInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([status])
}

model SurveyResponse {
  id           String   @id @default(cuid())
  invitationId String   @unique
  answers      Json
  submittedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  invitation SurveyInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model Client {
  id         String    @id @default(cuid())
  clientCode String    @unique
  toolUsed   String
  startDate  DateTime
  endDate    DateTime?
  notes      String?
  // IMMUTABLE
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model BudgetAllocation {
  id          String   @id @default(cuid())
  userId      String?
  category    String
  budgetHours Float
  hourlyRate  Float
  description String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model PlanningVersion {
  id              String                @id @default(cuid())
  revision        Int                   @unique
  status          PlanningVersionStatus @default(CONCEPT)
  sourceStatus    PlanningSourceStatus
  sourceReference String                @db.Text
  periodStart     DateTime
  periodEnd       DateTime
  createdById     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  createdBy   User                    @relation(fields: [createdById], references: [id])
  allocations MonthlyPlanAllocation[]

  @@index([status])
  @@index([createdById])
}

model MonthlyPlanAllocation {
  id                String                        @id @default(cuid())
  planningVersionId String
  monthStart        DateTime
  budgetLineKey     String
  roleCategory      String
  label             String
  workPackageId     String
  activityId        String
  plannedHours      Float
  rationale         String                        @db.Text
  sourceState       PlanningAllocationSourceState
  reviewState       PlanningReviewState           @default(DRAFT)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  planningVersion PlanningVersion @relation(fields: [planningVersionId], references: [id], onDelete: Cascade)
  workPackage     WorkPackage     @relation(fields: [workPackageId], references: [id])
  activity        Activity        @relation(fields: [activityId], references: [id])
  forecastEntries ForecastEntry[]

  @@unique([planningVersionId, monthStart, budgetLineKey, workPackageId, activityId])
  @@index([planningVersionId])
  @@index([monthStart])
}

model ForecastEntry {
  id           String   @id @default(cuid())
  allocationId String
  plannedDate  DateTime @db.Date
  executorName String
  plannedHours Float
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  allocation            MonthlyPlanAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  materializedHourEntry HourEntry?

  @@unique([allocationId, plannedDate, executorName])
  @@index([plannedDate])
  @@index([executorName])
}

model InterimHourProposalSet {
  id                 String   @id @default(cuid())
  requestKey         String
  requestFingerprint String
  asOf               DateTime @db.Date
  calculationVersion String
  sourceReference    String   @db.Text
  attestedById       String
  attestedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  attestedBy User                  @relation(fields: [attestedById], references: [id], onDelete: Restrict)
  proposals  InterimHourProposal[]

  @@unique([attestedById, requestKey])
  @@unique([asOf, calculationVersion])
  @@index([asOf])
  @@index([attestedById])
}

model InterimHourProposal {
  id                         String   @id @default(cuid())
  proposalSetId              String
  budgetLineKey              String
  title                      String
  workPackageId              String
  activityId                 String
  targetQuarters             Int
  registeredBaselineQuarters Int
  proposedQuarters           Int
  rationale                  String   @db.Text
  createdAt                  DateTime @default(now())

  proposalSet InterimHourProposalSet @relation(fields: [proposalSetId], references: [id], onDelete: Restrict)
  workPackage WorkPackage            @relation(fields: [workPackageId], references: [id], onDelete: Restrict)
  activity    Activity               @relation(fields: [activityId], references: [id], onDelete: Restrict)
  hourEntries HourEntry[]

  @@unique([proposalSetId, budgetLineKey, workPackageId, activityId])
  @@index([proposalSetId])
  @@index([workPackageId])
  @@index([activityId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  reason      String   @db.Text
  beforeData  Json?
  afterData   Json?
  actorUserId String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
